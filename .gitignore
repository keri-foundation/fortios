# Xcode / Swift
.DS_Store
*.xcuserstate
*.xcuserdata/
DerivedData/
build/

# Local/generated App Store export options (environment-specific release
# configuration that may contain signing/provisioning mappings). The
# committed template is ExportOptions.plist.example.
ExportOptions.plist

# Xcode per-user state inside nested projects
xcodeproj/**/xcuserdata/

# Bundled web payload output should not be committed.
# Keep the directory via .gitkeep.
WebPayload/*
!WebPayload/.gitkeep

# Optional local overrides (debug-only) should never be committed.
WebPayloadOverride/*
!WebPayloadOverride/.gitkeep

# Node tooling (never commit)
node_modules/

# Python / misc
__pycache__/
*.pyc
*.pyo
.envrc

# IDE
.sourcekit-lsp/
*.swp

# Test output
test-results/
.pytest_cache/

# Release candidates and distribution artifacts (generated, environment-specific)
*.xcarchive
*.ipa
*.dSYM

# Runtime producer checkout (populated by CI and local packaging runs)
.deps/

# Secret-sensitive material. Templates carry no values and stay committable.
.env
.env.*
!.env.example
*.p12
*.pfx

# Build logs and scratch output
*.log
*.tmp
*.bak
*.orig

# Xcode per-user state (directory form used inside .xcodeproj) and SwiftPM cache
xcuserdata/
.swiftpm/
